{
  "name": "lens-visualizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node scripts/generate-build-metadata.mjs && vite",
    "build": "node scripts/organize-lens-data.mjs && node scripts/generate-build-metadata.mjs && node scripts/generate-src-readmes.mjs && vite build && node scripts/prerender.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-rss-feeds.mjs",
    "generate:metadata": "node scripts/organize-lens-data.mjs && node scripts/generate-build-metadata.mjs && node scripts/generate-src-readmes.mjs",
    "generate:readmes": "node scripts/generate-src-readmes.mjs",
    "generate:feeds": "node scripts/generate-rss-feeds.mjs",
    "organize:lens-data": "node scripts/organize-lens-data.mjs",
    "preview": "vite preview",
    "pretest": "node scripts/generate-build-metadata.mjs",
    "test": "vitest run",
    "pretest:coverage": "node scripts/generate-build-metadata.mjs",
    "test:coverage": "vitest run --coverage",
    "generate:glass-reports": "node scripts/generate-glass-reports.mjs",
    "generate:mirror-reports": "vitest run mirrorFixtureAuthoringReport",
    "generate:mount-svgs": "vitest run mountSvgSpecificationsReport",
    "generate:sa-figure-svgs": "SA_FIGURE_SVGS_WRITE=1 vitest run sphericalAberrationStaticSvgs",
    "generate:holiday-branding": "node scripts/generate-holiday-branding.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "audit:working-aperture": "node --import ./scripts/ts-js-specifier-hook-register.mjs scripts/audit-working-aperture.mjs",
    "audit:image-circle": "node --import ./scripts/ts-js-specifier-hook-register.mjs scripts/audit-image-circle.mjs",
    "audit:patent-figure": "node --import ./scripts/ts-js-specifier-hook-register.mjs scripts/audit-patent-figure.mjs",
    "audit:surface": "node --import ./scripts/ts-js-specifier-hook-register.mjs scripts/audit-surface-probe.mjs",
    "benchmark:optics-rendering": "node scripts/benchmark-optics-rendering.mjs",
    "pretypecheck": "node scripts/generate-build-metadata.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\" \"__tests__/**/*.{js,ts,tsx}\" \"scripts/**/*.{mjs,ts}\" \"*.config.js\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\" \"__tests__/**/*.{js,ts,tsx}\" \"scripts/**/*.{mjs,ts}\" \"*.config.js\"",
    "seo:audit": "node scripts/seo-audit.mjs",
    "check:glass-reports": "node scripts/generate-glass-reports.mjs --check"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "katex": "^0.16.45",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
