   *    rayFractions, offAxisFieldFrac, and the other overridable values. */
  scFill:           0.50,   // horizontal fill fraction 0–1 (default 0.55)
  yScFill:          0.30,   // REQUIRED: vertical fill fraction 0–1 (no default)
