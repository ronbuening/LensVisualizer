 * ║    Zoom variable gaps: D5, D13 (zoom only).                          ║
 * ║    Focus variable gaps: D30, D34 (zoom + focus).                     ║
 * ║    Reversing groups: D34 (non-monotonic).           [if applicable]  ║
 * ║                                                                      ║
 * ║  NOTE ON SCALING (if applicable): [scale factor s applied to R, d,   ║
 * ║    sd and other lengths; A_p → A_p / s^(p−1); K unchanged. See       ║
 * ║    LENS_DATA_SPEC.md § Data Sourcing Checklist, item 9.]             ║
 * ║  NOTE ON SEMI-DIAMETERS: [patent-listed, estimated from EP geometry, ║
 * ║    refined against a published cross-section, ...]                   ║
 * ║  NOTE ON STOP POSITION (if inferred): [e.g. "inferred from Fig. 1"]  ║
 * ║  NOTE ON MIRROR/FOLDED PATHS (if applicable): [mirror kinds, annular ║
 * ║    apertures/obstructions, surfaceOrder or auto mode, image-plane    ║
 * ║    placement, shared-blank splits and whether elementCount is the    ║
 * ║    physical patent count.]                                           ║
 * ║                                                                      ║
 * ║  Optical design only: glass/mirror surfaces, stop, variable gaps.    ║
 * ║  No sensor glass, filters, mechanics, or parent/donor designs.       ║
 * ║  See LENS_DATA_SPEC.md § Scope: What to Include.                     ║
 * ╚══════════════════════════════════════════════════════════════════════╝
 */

const LENS_DATA = {

  /* ── Identity ── See LENS_DATA_SPEC.md § Top-Level Fields and § Display Name Convention */
  key:      "unique-lens-key",                          // REQUIRED: lowercase a-z/0-9 words joined by single hyphens; becomes the /lens/ URL
  maker:    "Manufacturer",                             // optional: canonical maker-page name (e.g. "Nikon", "Voigtländer"); derived from name if omitted
  // visible: true,                                     // optional: false hides the lens from the UI dropdown (default: true)
  name:     "MANUFACTURER BRAND MOUNT 50mm f/1.8 CHARACTERISTIC", // REQUIRED: all-caps maker + branding, separated mount/system tokens, `FLmm f/N`
  subtitle: "PATENT-NUMBER EXAMPLE N — COMPANY / INVENTOR",  // optional: compact example/correlation context; UI/report fallback
  specs: [                                               // optional: spec strings for header display
    "N ELEMENTS / N GROUPS",
    "f ≈ NN.N mm",
    "F/N.N",
    "2ω ≈ NN.N°",
    "N ASPHERICAL SURFACES",
  ],

  /* ── Explicit metadata fields ── See LENS_DATA_SPEC.md § Optional, § Mount And Image-Format Metadata,
   *    and § Patent Metadata. Patent-backed files declare patentNumber/patentAuthors/patentAssignees together. */
  focalLengthMarketing: 50,             // mm; single number for primes, [wide, tele] for zooms
  focalLengthDesign:    51.2,           // patent/computed EFL in mm; omit if same as focalLengthMarketing
  apertureMarketing:    1.8,            // marketed max f-number
  apertureDesign:       1.85,           // patent/computed max f-number; omit if same as apertureMarketing
  lensMounts:           ["nikon-z"],     // optional; canonical ids from src/utils/catalog/lensTaxonomy.ts only, e.g. ["nikon-z", "sony-fe"]
  imageFormat:          "135-full-frame", // optional; ONE canonical id, e.g. "aps-c", "110", "4x5"; required for perspective-control sampling
  patentNumber:         "US 10,571,651 B2", // jurisdiction + number + kind code; no example/table label
  patentAuthors:        ["Hideki Sakai"],   // inventors in source order, Given Middle Family; [] only when the source names none
  patentAssignees:      ["Canon Inc."],     // canonical legal-entity names, no locations; [] only when the source names none
  patentYear:           2019,               // year of the publication/grant named by patentNumber
  elementCount:         12,                 // physical glass elements (patent count, even if `elements` adds a shared-blank plug entry)
  groupCount:           9,                  // air-separated groups

  // Optional: signed SHIFT/TILT limits for a real perspective-control lens; omit for ordinary and folded lenses.
  // See LENS_DATA_SPEC.md § Perspective Control Movement (perspectiveControl).
  // perspectiveControl: {
  //   shiftRangeMm: [-11.5, 11.5],     // [min, max] must include 0; [0, 0] disables the axis
  //   tiltRangeDeg: [-8.5, 8.5],
  //   shiftStepMm: 0.1,
  //   tiltStepDeg: 0.1,
  //   tiltPivot: {                     // required for non-zero tilt; omit for shift-only lenses
  //     frame: "camera",
  //     basis: "rear-vertex-fallback", // or "mechanical-axis" / "patent-principal-point-guidance" — see spec
  //     zOffsetFromImagePlaneMm: -56.5, // finite negative mm, objectward from the fixed image plane at the reference state
  //   },
  // },

  // Optional: non-rectilinear projection metadata; omit for ordinary rectilinear lenses.
  // See LENS_DATA_SPEC.md § Projection Metadata.
  // projection: {
  //   kind: "fisheye-equidistant",     // "fisheye-equidistant" | "fisheye-equisolid" | "rectilinear" (rare ultrawide override)
  //   focalLengthMm: 6.3,
  //   fullFieldDeg: 220,
  //   imageCircleMm: 23,
  //   maxTraceFieldDeg: 80,
  // },

  // Optional: folded/mirror optical path; omit this entire block for ordinary sequential refractive lenses.
  // Provide surfaceOrder or mode: "auto" — never imagePlane alone.
  // See LENS_DATA_SPEC.md § Folded And Mirror Optical Paths (opticalPath).
  // opticalPath: {
  //   mode: "auto",                                      // "sequential" (default) or "auto"
  //   surfaceOrder: ["STO", "MG1", "MG2", "MG1"],       // optional explicit hit order; labels may repeat
  //   imagePlane: { z: 35, y: 25, normal: { z: 0, y: 1 }, label: "IMG" },
  //   maxInteractions: 8,
  // },

  /* ── Elements ── one entry per physical glass/mirror element, front to rear; each id unique and
   *    referenced by at least one surface. See LENS_DATA_SPEC.md § Element Object and § Glass Identification.
   *    REQUIRED: id, name, label, type, nd.   Recommended: vd, fl, glass (inspector display).
   *    Optional: indexReference ("d"|"e"), apd/apdNote/dPgF, nC/nF/ng, diagramLabel, role, cemented,
   *              fromSurface/toSurface (embedded-stop and folded-mirror spans only). */
  elements: [
    { id: 1, name: "L1", label: "Element 1", type: "Biconvex Positive",  nd: 1.00000, vd: 00.00, fl:  00.0, glass: "Glass Name (CATALOG)", apd: false, role: "Description of optical role" },
    // Embedded-stop element example:
    // { id: 2, name: "L2", label: "Element 2", type: "Biconvex Positive", nd: 1.70000, fromSurface: "3", toSurface: "4", ... },
    // ... one entry per glass element, front to rear
  ],

  /* ── Surface prescription ── one entry per optical surface (glass, mirror, blocker, AND air gaps).
   *    Ordinary lenses: physical front-to-rear order; folded systems document their order in the header.
   *    See LENS_DATA_SPEC.md § Surface Object, § Sign Conventions, § Surface Label Convention, § Pairing Rules.
   *
   *  Fields: label (unique; append "A" for aspheric), R (mm; 1e15 = flat; R > 0 → center of curvature to the RIGHT),
   *    d (mm to the next surface; ≥ 0 for sequential lenses), nd (index of the medium AFTER this surface; 1.0 = air),
   *    elemId (0 for air interfaces), sd (outer semi-diameter, mm), innerSd (optional annular hole radius, < sd),
   *    diffractive (optional; § Diffractive Phase Surfaces (diffractive)), interaction (optional; § Surface Interactions),
   *    stopPlacement (STO inside glass only; § Aperture Stop).
   *
   *  elemId rules: each glass element owns EXACTLY ONE surface — its front (entry) surface. Exit-to-air surfaces
   *    and an air STO use elemId: 0; a cemented junction carries the NEXT element's elemId and nd. buildLens() renders
   *    each element from the FIRST surface with its elemId to the following surface, so tagging a rear or air surface
   *    with a non-zero elemId draws the wrong span; use fromSurface/toSurface only for the documented exceptions.
   *    { label: "5", R: ..., d: ..., nd: 1.49700, elemId: 3, sd: ... },  // L3 front — elemId: 3
   *    { label: "6", R: ..., d: ..., nd: 1.72047, elemId: 4, sd: ... },  // L3→L4 cemented junction — elemId: 4
   *    { label: "7", R: ..., d: ..., nd: 1.0,     elemId: 0, sd: ... },  // L4 rear → air — elemId: 0
   *  Triplet, hybrid glass+resin, embedded-stop, mirror, blocker, and diffractive patterns: § Pairing Rules,
   *    § Authoring Patterns, § Annular Mirror Nesting And Shared Blanks, § Reference Fixtures.
   *
   *  Semi-Diameter Guidelines:
   *    Validated automatically (see § Data Sourcing Checklist item 2, § Validation, and § Aspherical Coefficients
   *    (asph)): edge thickness (the rim sags of an element must not cross its center thickness), front/rear SD
   *    ratio ≤ 3×, rim slope ≤ ~64.2° including aspheric terms, cross-gap intrusion ≤ gapSagFrac × gap on the shared
   *    radial band, conic height for K > 0, and > 0.25 mm of hidden render trim fails the production sweep.
   *    Guidance the validator does not enforce:
   *    - Cemented junctions share one clear aperture: keep the SDs on both sides nearly identical.
   *    - SDs should shrink smoothly toward the STO and grow smoothly after it; abrupt jumps are data errors.
   *    - After sizing SDs from on-axis marginal rays, confirm off-axis bundles (offAxisFieldFrac × half-field) clip
   *      at element edges or air gaps, never inside cemented groups; thick elements amplify off-axis divergence
   *      and may need tighter upstream SDs.
   *    - Annular mirrors use innerSd for the hole; solid central obstructions use a separate
   *      interaction: { type: "block" } surface (§ Annular Apertures And Obstructions).
   */
  surfaces: [
    { label: "1",   R:   00.000, d: 0.00, nd: 1.00000, elemId: 1, sd: 00.0 },
    { label: "2",   R:   00.000, d: 0.00, nd: 1.0,     elemId: 0, sd: 00.0 },
    // ...
    { label: "STO", R:     1e15, d: 0.00, nd: 1.0,     elemId: 0, sd: 00.0 },  // aperture stop — EXACTLY ONE required
    //  Stop position: use the patent's value; otherwise split the air gap at the figure's iris location and comment
    //  the estimate (e.g. "STO position inferred from Fig. 1"). Stop inside glass: keep STO flat and use
    //    { label: "STO", R: 1e15, d: ..., nd: glass_nd, elemId: glass_elem_id, sd: ..., stopPlacement: "inside-element" }
    //  See LENS_DATA_SPEC.md § Aperture Stop.
    // ...
    // Last surface's d = BFD to the image plane (sequential lenses); folded systems declare opticalPath.imagePlane instead.
  ],

  /* ── Aspherical coefficients ── keyed by surface label; aspheric surfaces only; all-spherical designs use asph: {}.
   *    A4–A14 required (0 when unused); A16–A20 and odd A3–A19 optional — include only published non-zero values.
   *    Patents writing √(1 − KA·(h/R)²) need K = KA − 1. See LENS_DATA_SPEC.md § Aspherical Coefficients (asph). */
  asph: {
    // "3A": {
    //   K: 0,
    //   A4: 0, A6: 0, A8: 0, A10: 0, A12: 0, A14: 0,
    //   // A16: 0, A18: 0, A20: 0,   // optional — include only if patent specifies
    //   // A3: 0, A5: 0, ..., A19: 0, // optional odd orders — include only if patent specifies
    // },
  },

  /* ── Variable air spacings (focus mechanism) ── keyed by surface label; only gaps that change during focus/zoom.
   *    Prime: [d_infinity, d_close]; zoom: one [d_inf, d_close] vector per zoomPositions entry (zoom-only gaps repeat
   *    the same value). The surface's d must equal the first (infinity, first zoom position) value.
   *    See LENS_DATA_SPEC.md § Variable Air Spacings (var) and § Focus types by number of variable gaps. */
  var: {
    // Prime:  "17": [18.74, 22.59],                            // [d_infinity, d_close]
    // Zoom:   "17": [[18.74, 22.59], [16.00, 20.00], [19.50, 23.80]],  // one pair per zoom position
  },

  // focusPositions: [0, 0.72, 1], // optional normalized focusT coordinates for 3+ published states

  varLabels: [
    // ["17", "BF"],             // [surface_label, display_text]
  ],

  /* ── Independent aberration control (optional) ── a real soft-focus / SA-control ring, not focus travel.
   *    Base surface d must match the first (normal/sharp) value. See LENS_DATA_SPEC.md § Aberration Control (aberrationControl). */
  // aberrationControl: {
  //   label: "SOFT",
  //   minLabel: "0",
  //   maxLabel: "3",
  //   step: 0.004,
  //   var: { "9": [2.074, 6.962], "11": [64.427, 53.951] },
  //   varLabels: [["9", "D(B0)"], ["11", "BF"]],
  // },

  /* ── Zoom lens fields (optional — omit entirely for prime lenses) ── presence of zoomPositions makes the lens a zoom.
   *    ≥ 2 focal lengths in mm, monotonically increasing; bracket any reversing group with an extra position.
   *    Variable-aperture zooms also set nominalFno (below) to an array. See LENS_DATA_SPEC.md § Zoom Lens Fields. */
  // zoomPositions: [24, 50, 70],
  // zoomStep: 0.004,
  // zoomLabels: ["Wide", "Tele"],

  /* ── Group and doublet annotations ── purely visual SVG brackets; fromSurface/toSurface must be valid labels.
   *    See LENS_DATA_SPEC.md § Group & Doublet Annotations. */
  groups: [
    // { text: "FRONT", fromSurface: "1", toSurface: "8" },
    // { text: "REAR",  fromSurface: "10", toSurface: "17" },
  ],

  doublets: [
    // { text: "D1", fromSurface: "5", toSurface: "7" },
  ],

  /* ── Focus configuration ── */
  closeFocusM:       0.45,       // REQUIRED: close focus distance in meters
  focusDescription:  "Description of the focus mechanism.",  // optional: shown in UI

  /* ── Aperture configuration ── */
  nominalFno:   2.0,             // REQUIRED: nominal f-number — used to derive stop SD; variable-aperture zooms use
                                   //   one value per zoom position, e.g. [4.5, 5.76] for f/4.5-5.6
  fstopSeries:  [1.4, 1.8, 2, 2.5, 2.8, 3.5, 4, 4.5, 5.6, 6.3, 8, 11, 16, 22],  // REQUIRED: f-stop quick-select values
  // apertureBlades: 9,                  // optional; reserved for future polygonal bokeh rendering
  // apertureBladeRoundedness: 0.5,      // optional 0–1; 0 = straight, 1 = circular

  /* ── Layout tuning ── override defaults.ts only when the defaults do not frame this lens well.
